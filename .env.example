# ==============================================================================
# Supabase Central (Base de Datos & Auth del Portal IDP)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-central-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Service Role de Supabase Central (OBLIGATORIA para el Cron Job y operaciones administrativas)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Seguridad & Acceso
# ==============================================================================
# Token secreto para validar ejecuciones de Vercel Cron o llamadas externas autorizadas
# Configurar la misma variable en el dashboard de Vercel como CRON_SECRET
CRON_SECRET=generate_a_secure_random_token_here_at_least_32_characters

# Correo del único administrador permitido para acceder al IDP (opcional pero recomendado)
ADMIN_EMAIL=admin@tuempresa.com

# URL base del despliegue (opcional para entornos locales vs producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000
